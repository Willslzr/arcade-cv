# ============================================================
# Variables de entorno — copia a .env.local y rellena
# En producción se configuran en Vercel → Settings → Environment
# Variables. NUNCA se commitean.
# ============================================================

# --- Upstash Redis (ranking global) -------------------------
# Crear en https://console.upstash.com → Create Database → Global
# Copiar desde la pestaña "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Firma de partidas --------------------------------------
# Cadena aleatoria larga. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEADERBOARD_SECRET=

# --- Origen público -----------------------------------------
# Dominio final, sin barra al final. Se usa para las cabeceras CORS.
PUBLIC_ORIGIN=https://tu-dominio.com
